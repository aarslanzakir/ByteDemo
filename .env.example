# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables.
# Values from Byte → Websites → Demo Website → Settings → Developer setup.
BYTE_SITE_ID=
BYTE_API_KEY=
BYTE_WEBHOOK_SECRET=

# Optional. Leave unset to use the live API
# (https://adminapi.byteadvisory.ai/api/v1/sites). Only set it to a local
# Docker backend (http://localhost:8001/api/v1/sites) when running locally.
BYTE_API_URL=
